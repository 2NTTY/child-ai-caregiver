# Upload only the shared mobile application and its build inputs.
/*
!/package.json
!/package-lock.json
!/tsconfig.json
!/frontend
!/src
!/assets
!/licenses
!/THIRD_PARTY_NOTICES.md
/src/*
!/src/client
!/src/config
!/src/shared
**/node_modules/
**/.cache/
**/.expo/
**/dist*/
**/web-build/
**/.npm-cache/
**/.expo-home/
**/.edge-profile*/
**/.env*
**/credentials*.json
**/google-services.json
**/*.keystore
**/*.jks
**/*.p12
**/*.key
**/*.keys
**/private/
**/secrets/
/frontend/.agents/
/frontend/verification/
/frontend/scripts/
/frontend/*.md
/frontend/tsconfig*.json
!/frontend/tsconfig.json

# EAS checks directory names before descending into them.
/assets/**/*.md
