{
  "name": "yuban-hk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "postinstall": "patch-package --patch-dir frontend/patches --error-on-fail",
    "agent:local": "node scripts/agent-local.mjs",
    "web": "npm run web --workspace frontend",
    "legacy:web": "node scripts/legacy-web-retired.mjs",
    "typecheck": "npm run typecheck --workspace frontend && tsc --noEmit && tsc --project tsconfig.server.json && tsc --project tsconfig.frontend-tests.json",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts",
    "build:web": "npm run build:web --workspace frontend && node scripts/prepare-web-output.mjs",
    "legacy:build:web": "node scripts/legacy-web-retired.mjs",
    "server": "node --env-file-if-exists=.env server/main.ts",
    "worker": "node --env-file-if-exists=.env server/worker-main.ts",
    "worker:control": "node --env-file-if-exists=.env scripts/firebase-control.mjs set-enabled",
    "db:migrate": "node scripts/sql-retired.mjs",
    "test:integration": "node --env-file-if-exists=.env scripts/verify-server.mjs",
    "test:records": "node --env-file-if-exists=.env scripts/verify-server.mjs --records",
    "test:web": "node --env-file-if-exists=.env scripts/verify-web.mjs",
    "setup:local": "node scripts/sql-retired.mjs",
    "storage:encrypt": "node scripts/sql-retired.mjs",
    "storage:backup": "node --env-file-if-exists=.env scripts/firebase-recovery.mjs",
    "storage:restore": "node --env-file-if-exists=.env scripts/firebase-recovery.mjs",
    "account:invitation": "node --env-file-if-exists=.env scripts/firebase-control.mjs invite",
    "account:journal": "node scripts/sql-retired.mjs",
    "firebase:control": "node --env-file-if-exists=.env scripts/firebase-control.mjs",
    "firebase:recovery": "node --env-file-if-exists=.env scripts/firebase-recovery.mjs",
    "mobile:prepare": "node frontend/tooling/normalize-fingerprint-paths.cjs",
    "mobile:release": "node scripts/mobile-release.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@google-cloud/firestore": "9.3.1",
    "@google-cloud/storage": "7.22.0",
    "@google-cloud/tasks": "7.2.1",
    "@google/adk": "2.1.0",
    "@google/genai": "2.24.0",
    "@hookform/resolvers": "5.9.1",
    "@react-pdf/renderer": "4.9.0",
    "cheerio": "1.2.0",
    "expo": "57.0.24",
    "expo-constants": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.22",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "10.9.1",
    "grammy": "1.46.0",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "mediabunny": "1.61.5",
    "patch-package": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.4",
    "@types/web-push": "3.6.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "better-auth": "1.7.5",
    "firebase-tools": "15.34.0",
    "nodemailer": "10.0.16",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "typescript": "6.0.3"
  }
}
