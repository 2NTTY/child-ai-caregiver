{
  "name": "yuban-hk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "web": "npm run web --workspace frontend",
    "legacy:web": "node scripts/legacy-web-retired.mjs",
    "typecheck": "npm run typecheck --workspace frontend && tsc --noEmit && tsc --project tsconfig.server.json",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts",
    "build:web": "npm run build:web --workspace frontend && node scripts/prepare-web-output.mjs",
    "legacy:build:web": "node scripts/legacy-web-retired.mjs",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "worker": "node --env-file-if-exists=.env server/worker-main.ts",
    "worker:control": "node --env-file-if-exists=.env scripts/worker-control.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/verify-server.mjs",
    "test:records": "node --env-file-if-exists=.env scripts/verify-server.mjs --records",
    "test:web": "node --env-file-if-exists=.env scripts/verify-web.mjs",
    "setup:local": "node scripts/setup-local-env.mjs",
    "storage:encrypt": "node --env-file-if-exists=.env scripts/encrypt-storage.mjs",
    "storage:backup": "node --env-file-if-exists=.env scripts/storage-backup.mjs backup",
    "storage:restore": "node --env-file-if-exists=.env scripts/storage-backup.mjs restore"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@google/adk": "2.1.0",
    "@google/genai": "2.24.0",
    "@hookform/resolvers": "5.9.1",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.5",
    "cheerio": "1.2.0",
    "expo": "57.0.24",
    "expo-constants": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.22",
    "grammy": "1.46.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.4",
    "@types/web-push": "3.6.4",
    "typescript": "6.0.3"
  }
}
