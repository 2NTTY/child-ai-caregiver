# Public deployment address only. Expo includes EXPO_PUBLIC_* values in the client.
# Same-origin API by default; local separate server example: http://localhost:3001/api
EXPO_PUBLIC_API_BASE_URL=/api

# Use npm run setup:local to generate an ignored .env for synthetic local development.
# Server-only values below must never use the EXPO_PUBLIC_ prefix.
DATABASE_URL=postgresql://yuban:replace-me@127.0.0.1:5433/yuban
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVER_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:8081
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Optional single trusted IPv4 proxy. Leave empty for direct local access.
TRUSTED_PROXY_IP=
DB_PASSWORD=replace-me
TEST_DB_PASSWORD=replace-me
TEST_DATABASE_URL=postgresql://yuban:replace-me@127.0.0.1:5434/yuban_s06_test

# Server-only AI settings. Enable AI only after setting a valid GCP project ID.
# Vertex AI uses server-side Application Default Credentials (ADC); keep credentials out of this file and EXPO_PUBLIC_* values.
# Local ADC: gcloud auth application-default login. Check that GOOGLE_APPLICATION_CREDENTIALS does not select another identity.
AI_ENABLED=false
GCP_PROJECT_ID=
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
AI_DAILY_USER_ATTEMPTS=20
AI_DAILY_GLOBAL_ATTEMPTS=100
# Separate service cap for personal-key generation and query embedding.
AI_PERSONAL_DAILY_GLOBAL_ATTEMPTS=1000
AI_MAX_ATTEMPTS=2
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=10000
# Interactive Agent logical JSON character cap (UTF-16): 32000-64000. Background stays 32000.
AI_AGENT_MAX_INPUT_CHARACTERS=64000
# Server-controlled Agent thinking level: minimal, low, medium, high. Default remains minimal.
# Reasoning shares the existing output-token cap; changing this setting does not raise quotas or prove semantic acceptance.
AI_AGENT_THINKING_LEVEL=minimal
AI_MAX_OUTPUT_TOKENS=1024

# Required Server-only storage key; separate backup key. Generate outside the repository.
STORAGE_KEY_FILE=
BACKUP_KEY_FILE=
# Optional local development only: run PostgreSQL tools inside this container (internal port 5432).
PG_TOOL_CONTAINER=

# P2 photo originals: dedicated absolute directory outside source, protected by Server OS account.
ATTACHMENTS_DIR=

# Opt-in invited real-data service; keep SMTP credentials in a protected external JSON file.
SERVICE_MODE=trial
ACCOUNT_SMTP_CONFIG_FILE=
# Required after migrations 034/035 even in trial mode. Initialize/bind explicitly before startup.
ACCOUNT_ERASURE_JOURNAL_DIR=

# F01 opt-in Firebase assembly. The production cutover is gated by F08 acceptance.
# Use the same SERVER_ORIGIN and WEB_ORIGIN. No SQL URL or Better Auth secret is read in this mode.
STORAGE_BACKEND=postgres
FIREBASE_DATABASE_ID=yuban-firebase
FIREBASE_NAMESPACE=yuban_authority
# GCP_PROJECT_ID and STORAGE_KEY_FILE above are required; use attached ADC, never a downloaded key.
