# Current API/worker use Firestore only. This sample contains no credentials.
# Copy to an ignored .env for local synthetic use, or a protected file outside Git for the VM.
# ADC stays on the host. Never place the storage key or an ADC credential in EXPO_PUBLIC_*.
STORAGE_BACKEND=firestore
EXPO_PUBLIC_API_BASE_URL=/api
EXPO_PUBLIC_AUTH_PROVIDER=firebase
# Public Firebase web-app configuration; copy the values from the existing approved app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ai-caregivers-for-children
EXPO_PUBLIC_FIREBASE_APP_ID=
# Local API requires an absolute protected key path; Compose supplies its secret mount.
STORAGE_KEY_FILE=
HOST=127.0.0.1
PORT=3001
# For local separate Web/API, change origins and EXPO_PUBLIC_API_BASE_URL together.
# Copy outside the repository. This file contains no credentials.
NODE_ENV=production
GCP_PROJECT_ID=ai-caregivers-for-children
FIREBASE_DATABASE_ID=yuban-firebase-20261011
FIREBASE_NAMESPACE=yuban_authority
FIREBASE_PHOTO_BUCKET=ai-caregivers-for-children-firebase-private
FIREBASE_ERASURE_BUCKET=ai-caregivers-for-children-firebase-journal
SERVER_ORIGIN=https://ex-machina.eu.org
WEB_ORIGIN=https://ex-machina.eu.org
# The VM attached identity provides ADC; do not set GOOGLE_APPLICATION_CREDENTIALS.
# Compose mounts the existing compatible Firestore key; never regenerate it to read old data.
FIREBASE_AUTH_EMAIL_ENABLED=false
FIREBASE_TASK_WORKER_ENABLED=false
# Enable only after every API/worker/restore reader supports the compatibility floor and message indexes are ready.
FIREBASE_MESSAGE_HISTORY_ENABLED=false
# Optional compose.firestore.channels.yaml mounts existing files; keep outbound channels disabled until release approval.
WEB_PUSH_ENABLED=false
TELEGRAM_ENABLED=false
# F03 platform chat uses the VM's existing Vertex identity, never a client key.
# Enable only for the approved release; preserve current daily limits, never use SDK defaults by accident.
AI_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_LOCATION=global
AI_MAX_ATTEMPTS=1
AI_DAILY_USER_ATTEMPTS=12
AI_DAILY_GLOBAL_ATTEMPTS=20
AI_AGENT_MAX_INPUT_CHARACTERS=64000
AI_MAX_OUTPUT_TOKENS=1024
FIREBASE_TASKS_REGION=asia-east2
FIREBASE_TASKS_QUEUE=yuban-firebase
FIREBASE_TASK_WORKER_ORIGIN=https://ex-machina.eu.org
FIREBASE_TASK_OIDC_AUDIENCE=https://ex-machina.eu.org
# Existing fixed dispatch identity; verify its OIDC audience when switching the endpoint.
FIREBASE_TASK_DISPATCH_SERVICE_ACCOUNT_EMAIL=yuban-firebase-dispatch@ai-caregivers-for-children.iam.gserviceaccount.com
# Set only reviewed published source IDs; never seed authority implicitly.
# FIREBASE_KNOWLEDGE_SOURCE_IDS=reviewed-source-id
