# Public deployment address only. Expo includes EXPO_PUBLIC_* values in the client.
# Same-origin API by default; local separate server example: http://localhost:3001/api
EXPO_PUBLIC_API_BASE_URL=/api

# Use npm run setup:local to generate an ignored .env for synthetic local development.
# Server-only values below must never use the EXPO_PUBLIC_ prefix.
DATABASE_URL=postgresql://yuban:replace-me@127.0.0.1:5433/yuban
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVER_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:8081
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
DB_PASSWORD=replace-me
TEST_DB_PASSWORD=replace-me
TEST_DATABASE_URL=postgresql://yuban:replace-me@127.0.0.1:5434/yuban_s06_test
