-* Only allow relative paths (`/^\/[^\s]*$/`) or allowlisted origins.
+* Do not classify a destination with a leading-slash regex: the inherited
+  `/^\/[^\s]*$/` also accepts `//example.invalid`, a protocol-relative external URL.
+* Parse using the consumer's URL semantics and a **trusted configured base origin**;
+  allow only the expected protocol and origin, reject embedded credentials, and
+  apply a context-specific destination allowlist. Do not derive trust from `Host`,
+  query input, string prefix checks, or a broad subdomain suffix match.
+* Example for browser full-page navigation after an account action: only these
+  exact same-origin routes are valid. Query/hash state is deliberately not needed
+  here and is rejected. If another flow needs it, validate its keys/values against
+  that flow's policy; do not simply relax this example. OAuth/callback destinations
+  require their own exact registered redirect policy.
+
+Local correction sources checked 2026-10-26:
+[WHATWG URL API and origin](https://url.spec.whatwg.org/#api) for parsing and
+serialized URL properties; [OWASP redirect guidance](https://cheatsheetseries.owasp.org/cheatsheets/Unvalidated_Redirects_and_Forwards_Cheat_Sheet.html)
+for allowlisted destinations. This example is locally adapted, not copied as an
+official universal validator.
+
+<!-- redirect-example:start -->
+```js
+const APP_ORIGIN = "https://app.example.invalid"; // Trusted deployment configuration.
+const ALLOWED_RETURN_PATHS = new Set(["/", "/account", "/settings"]);
+function safeReturnTo(raw) {
+  const fallback = `${APP_ORIGIN}/`;
+  if (typeof raw !== "string" || raw.length === 0 || /[\u0000-\u0020\u007f\\]/.test(raw)) {
+    return fallback;
+  }
+  try {
+    const target = new URL(raw, APP_ORIGIN);
+    if (target.protocol !== "https:" || target.origin !== APP_ORIGIN ||
+        target.username || target.password || target.search || target.hash ||
+        !ALLOWED_RETURN_PATHS.has(target.pathname)) {
+      return fallback;
+    }
+    return target.href; // Navigate to this parsed result, never the original input.
+  } catch {
+    return fallback;
+  }
+}
+```
+<!-- redirect-example:end -->
+
+Synthetic offline regression for this exact example (no navigation/network):
+
+<!-- redirect-regression:start -->
+```js
+const assert = require("node:assert/strict");
+const fallback = `${APP_ORIGIN}/`;
+for (const input of [
+  "//example.invalid/account", "/\\example.invalid/account",
+  "https://example.invalid/account", "http://app.example.invalid/account",
+  "https://user:pass@app.example.invalid/account", "javascript:alert(1)",
+  "data:text/html,test", " /account", "/account\n", "/account?next=//example.invalid",
+  "/account#fragment", "/not-allowed", "/%2f%2fexample.invalid", "https://[", null,
+]) assert.equal(safeReturnTo(input), fallback, String(input));
+for (const input of ["/account", "https://app.example.invalid/account"]) {
+  assert.equal(safeReturnTo(input), `${APP_ORIGIN}/account`);
+}
+assert.equal(safeReturnTo("/settings"), `${APP_ORIGIN}/settings`);
+```
+<!-- redirect-regression:end -->
