# Offline alternative for the fixed PGDG Debian 12 amd64 package.
# Build context contains only pgvector.deb and the upstream LICENSE.
FROM postgres:18.6-bookworm
LABEL org.opencontainers.image.description="PostgreSQL 18.6 with PGDG pgvector 0.8.6" \
    org.opencontainers.image.source="https://apt.postgresql.org/pub/repos/apt/pool/main/p/pgvector/" \
    org.opencontainers.image.version="18.6-pgvector0.8.6-pgdg12+2"
COPY pgvector.deb /tmp/pgvector.deb
RUN set -eu; \
    echo 'c014676900ce4af14f85e4c438ba2d488a4dcb8f684bc03ff908bac184910081  /tmp/pgvector.deb' | sha256sum -c -; \
    test "$(dpkg-deb -f /tmp/pgvector.deb Package)" = 'postgresql-18-pgvector'; \
    test "$(dpkg-deb -f /tmp/pgvector.deb Version)" = '0.8.6-1.pgdg12+2'; \
    test "$(dpkg-deb -f /tmp/pgvector.deb Architecture)" = "$(dpkg --print-architecture)"; \
    dpkg-deb -x /tmp/pgvector.deb /; \
    ldd /usr/lib/postgresql/18/lib/vector.so > /tmp/vector-dependencies.txt; \
    ! grep -q 'not found' /tmp/vector-dependencies.txt; \
    rm /tmp/pgvector.deb /tmp/vector-dependencies.txt
COPY LICENSE /usr/share/doc/pgvector/LICENSE
