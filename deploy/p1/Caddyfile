{$PUBLIC_HOST} {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy same-origin
    @api path /api /api/*
    handle @api {
        reverse_proxy api:3001 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        root * /srv
        try_files {path} {path}.html {path}/index.html
        file_server
    }
}
