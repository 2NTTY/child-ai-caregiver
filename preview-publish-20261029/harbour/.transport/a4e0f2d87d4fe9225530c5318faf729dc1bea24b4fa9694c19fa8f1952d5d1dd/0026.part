107:function(module,exports,__require){
"use strict";
Object.defineProperty(exports, "__esModule", { value: true });
exports.longMessage = exports.longCare = exports.chapters = void 0;
// Authored fictional family notes. No generated model output or real family data.
exports.chapters = [
    ['星期一的書袋', '早上出門前，小晴把兩本圖畫書放在地氈上，一本是有月亮的故事，另一本只有圖畫沒有文字。她說想把月亮那本留給公仔，自己帶另一本回學校。我原本已經拿好書袋，差點替她選好，後來把袋口打開，讓她慢慢把書放進去。她放了一本又抽出來，指着封面的紅色小屋說，放學後還想繼續講這間屋裏住了誰。我們約好回家先把書袋放回木櫃旁，不必立即完成整個故事。出門時她記得自己提書袋，走到門口才發現水樽還在桌上，於是回去拿，沒有再把兩件事混在一起。這次我想留下的不是有沒有準時做好，而是她開始知道自己可以負責哪一小步，也能說出想暫時保留甚麼。'],
    ['月亮那一頁', '晚飯後，小晴把公仔排在梳化前，說牠們要先坐好才可以聽故事。她沒有照書頁次序翻，而是直接翻到月亮露出一半的畫面，用手指沿着屋頂畫了一條看不見的路。我問路通去哪裏，她說通往一個不用關燈的小房間，又把公仔移到我的膝上，請我替牠回答。我沒有急着讀下一頁，只把她剛說的話再說一次。她接着補充，房間裏要有水、薄被和放書的架。讀到一半她去拿積木，我以為她不想看了，原來她是想搭那個小房間。書就攤在旁邊，成了積木故事的一部分。睡前她只說明天再加一扇窗，我把這句寫在便條上，放在書內，讓未完成的想法有一個可以回來的位置。'],
    ['積木角的新位置', '星期二下午，我們把客廳靠窗的一角空出來，並沒有把所有玩具一次清掉。小晴先把正在搭的橋移到一塊硬紙板上，告訴我這個不能拆，因為下面還沒有放河流。其餘積木有些按顏色排，有些按長短分，我起初想給每一盒貼同一種標籤，她卻說短的藍色可以和短的黃色住一起。我們試着照她的分法，把最常用的長條放在低一格，細小的圓片另用淺盒。整理中她走開喝水，回來時還記得未放好的紅色輪子。最後只留兩盒在地上，其他放回架上。這個安排不是要求她每次照同一順序收拾，而是看看盒子是否容易拿、是否看得見原來的作品，以及大人能否用一句清楚的話邀請她參與。'],
    ['下雨天的小火車', '本來想去公園的那個早上一直下雨，小晴站在窗邊看水沿玻璃流下來，說樹葉都在洗澡。我們先把出門的小背包放回椅子上，沒有說成行程取消就甚麼都不能做。她把四張椅子排成火車，拿紙畫了三張車票，第一張給外婆，第二張給公仔，第三張說是留給還沒上車的人。我坐在最後一張椅子，讓她決定在哪裏停站。她有時只想沿窗邊走一圈，有時又要回去檢查車票，玩法並不固定。午飯前我們只收好擋着走路的椅子，車票留在小碟裏。下午雨停了，她沒有再要求出門，反而拿出車票告訴爸爸上午經過甚麼地方。我記下的是她怎樣把原先的期待轉成另一個故事，而不是把室內活動算作補足原來的計劃。'],
    ['圖書館裏的選擇', '星期三到圖書館還書，我們先在入口旁把要還的書數清楚。小晴一開始想把所有封面有動物的書都拿下來，後來坐在矮凳上，一本一本翻給我看。她在其中一本停得特別久，因為每一頁的小兔都躲在不同位置。我問她想借哪本，她說想借可以找兔子的，也想借一本讓外婆講。我們沒有用讀了幾頁決定哪本比較好，而是讓她說出想回家再看的原因。借書後她自己把收據夾進書袋，走到出口又回頭看故事角的地氈。下次可以預留一點坐下來的時間，不一定每次都要參加活動；如果當天人多或她累了，先還書便走也可以。這份筆記留給家人，是想讓下一個陪她去的人知道，她喜歡的是慢慢找畫裏的小細節。'],
    ['外婆帶來的紙船', '外婆來的下午，帶了一疊乾淨的舊月曆紙。小晴看見背面空白，就說可以做河流，外婆提議先摺一隻小船。第一隻船的尖角沒有對齊，她把紙攤開，看了很久，說想再試一次。我沒有替她壓平每一道摺痕，只在她問的時候幫忙按住紙邊。第二隻仍然有一邊高一邊低，她卻喜歡那個形狀，說可以讓公仔靠着坐。我們把船放在藍色紙上，旁邊接着她前一天搭的小橋。離開前，外婆問下次要帶甚麼，她回答只要再帶幾張大紙，不需要新的玩具。這段互動提醒我，同一份材料在不同家人手中可以有不同玩法，毋須安排成教學步驟；她需要幫忙的地方也會隨着當天的想法改變。'],
    ['散步時停下來', '星期四黃昏走過公園，小晴在大樹旁停下，看見自己的影子比早上長。她先踩着我的影子走，又跑到另一邊比較。我提醒她留在看得見我的地方，然後站着等她把話說完。她說影子像一條拉長的圍巾，還想找一片葉子放在影子的頭上。那天我們沒有走原定的大圈，只走到長椅附近便回家。途中她撿了三片已掉在地上的葉子，放在紙袋，沒有摘樹上的。回家後我們先洗手，葉子放在報紙上晾乾。晚飯時她只講了影子的一件事，葉子的故事留到第二天才說。我想記住的是停下來的時間也屬於散步，不必因為路程短了就補做另一項活動。家人若想接着聊，可以先問她哪片葉子像圍巾，而不是要她重述整段經過。'],
    ['餐桌上的小工作', '晚飯前，小晴想幫忙擺餐墊，我把容易拿的幾張放在矮櫃上，請她先選自己的位置。她把每張餐墊放得很近，說大家要一起坐，我便指着碗的位置，和她試着留出放手的空間。她替公仔也留了一張，後來發現桌子不夠大，就把公仔放在旁邊的小凳。擺好後她又去畫畫，沒有一直留在餐桌旁等開飯。我們沒有要求她負責整套餐具，只把這一件小工作當成參與晚飯準備的機會。有一天她不想做，我自己完成，也沒有把前幾天做過當成她往後必須做到的承諾。這份記錄會放在日常安排旁，讓爸爸和外婆知道同一件事可以邀請、可以暫停，也可以隨當天的時間改成更小的一步。'],
    ['家長會後留下的話', '家長會時，老師提到小晴喜歡故事角，常會等同學先選，再把另一本文字少的圖畫書拿過來。老師沒有把這說成固定性格，只描述了最近幾次看到的情況。我回家沒有立即追問她在學校讀了甚麼，而是在整理書袋時說，老師提起你們有一個可以坐下看書的地方。她接着說那裏有一個綠色坐墊，還有一本很厚的書。我把老師的觀察和她自己的話分開記下，沒有把兩者合成一個確定結論。下一次和老師見面，想問的只是她怎樣選書、何時會邀請朋友一起看，以及家裏可否接着保留她喜歡的題材。如果老師當天有其他重要事項，我們也可以先聽，不必把準備好的問題逐條問完。'],
    ['和朋友輪流搭橋', '週五放學後，朋友來家裏玩積木。兩個孩子一開始都想拿同一塊長積木，小晴把它抱在懷裏，朋友則拿了另外兩塊。我先把要走路的位置清出來，等她們說各自想搭甚麼。小晴說要搭橋，朋友說要搭車站，後來她們把橋接在車站旁，並沒有真的輪流使用那塊積木。我沒有把這一刻寫成已學會分享，只記下她們怎樣找到可以同時玩的安排。中間仍有幾次需要大人幫忙說清楚，例如哪一部分暫時不能拆、哪些散件可以拿。朋友離開時，小晴想保留橋，我們找了一塊托盤放好，約定過兩天再看看是否仍想繼續。這樣的記錄比較接近實際發生的過程，也方便下次回看時，不把一次順利的遊戲當成每次都會一樣。'],
    ['晚上沒有讀完的故事', '有一晚大家都比平時疲倦，小晴拿着書走過來，翻了兩頁便把頭靠在我身上。我本來想把那一小章讀完，後來問她想聽我讀，還是先一起看圖。她說想看窗外的月亮，我們便把書放下，站在窗邊看了一會兒。天上有雲，月亮並不清楚，她說可能去了書裏。睡前我只把這句記下，沒有再請她畫出來或想一個結局。第二天她忘了這件事，也沒有關係；這些筆記是讓家人記得曾經一起看過甚麼，不是要她每次都接上昨天的話。有時我自己回看，會發現當時最重要的是可以安靜靠着，而不是書的內容。之後安排晚間時間時，可以把共讀放在一個有彈性的位置，保留直接休息的選擇。'],
    ['週末背包的分工', '星期六出門前，我們把要帶的東西放在門邊的小桌。小晴想自己背圖畫書和水樽，我讓她試着拿起背包，再問是否需要分一點給我。她走了幾步，說書有點重，於是把書放進我的袋，自己的背包留下水樽、手帕和一個裝葉子的空紙袋。我負責替換衣物和最後檢查，她負責看看水樽有沒有放好。這份清單不按多少件物品判斷她是否完成，而是幫助我們出門前有一個共同看過的地方。回家後，紙袋裏只有一片葉子，她仍很高興地把它放在桌上。收拾時先把水樽拿出來清洗，其他東西等休息後才整理。下次若改去圖書館，便把紙袋換成書袋，不需要重新建立一整套很長的規則。'],
    ['保留原話和修正', '整理這星期的筆記時，我發現星期四的散步時間原先寫成早上，其實是在放學後。我把時間改回黃昏，保留更正原因，沒有改掉小晴說影子像圍巾的原話。另有一段寫她把落葉按大小排好，後來爸爸提醒我，她排到一半又把小葉子放在中間，說這樣才像一家人。因此記錄中加入這個後續，而不是只留下最整齊的一刻。日常記憶有時會不完整，能指出誰記下、何時核對、哪裏更正，比把每段寫得像完整故事更有用。這份較長的原文是為了回看細節，平日清單只需顯示簡短題目；要了解當時怎樣發生，才打開原記錄慢慢讀。家人有不同記憶時，也可以先並列，不急着選一個聽起來最好的版本。'],
    ['下一星期留白的地方', '看完這些片段，我們只留下三件想接着做的小安排：圖書袋仍放在木櫃旁、積木角保留正在搭的小橋、下次散步預留在長椅休息的時間。其他事情沒有排成每天必須完成的表。我想請爸爸在有空時看看那張月亮便條，外婆下次來可以再問紙船要去哪裏，老師的問題則等見面前再核對一次。小晴未必會對同一題材維持相同興趣，她也可能突然想畫別的東西。這份整理只反映目前留下的生活片段，不把沒有記下的部分當成沒有發生，也不由某一次表現推論能力。若下星期很忙，我們可以只留一句話，等有時間再補背景；重點是下一個照顧她的人能接上她想說的事，而不是讓筆記本身成為另一項需要追趕的工作。'],
];
exports.longCare = exports.chapters.map(([title, text]) => title + '\n' + text).join('\n\n');
exports.longMessage = '我想把這兩星期家裏發生的片段完整留下，方便日後和爸爸、外婆或老師接着聊。下面都是我先在紙上記下，再按當時情況整理的話；有些地方仍然只是自己的觀察，我沒有想用它們評分。\n\n' + exports.longCare + '\n\n讀完後，我最想問的不是應該再安排多少活動，而是怎樣在生活很趕的時候，仍然留一點空間聽她把話說完。像星期一出門前，我們其實只有幾分鐘；如果我把每個步驟都當成要練習，她和我都會更累。可是完全替她做完，她又會覺得自己的書袋和背包沒有由自己決定的地方。我想試的是每次只留一個可以自己選的小位置，其他由大人先處理，然後看看這樣是否讓早上舒服一點。\n\n還有原文和整理版本的差別。我希望下次回看時，仍然能找到她說月亮去了書裏、影子像圍巾的那些句子，不要只剩下幾個分類名稱。整理可以幫忙找資料，但不需要把一段生活變成總結式的判斷。有些筆記後來會更正時間，有些只記得大概，我寧願把不確定的地方留下，也不想為了讓頁面整齊而補一個其實不知道的日期。\n\n最後是家人接手的方式。爸爸較常陪她搭積木，外婆會帶紙來，老師看到的是另一個環境。如果每個人只問同一組問題，小晴可能會覺得被反覆追問。比較想保留的是幾個自然的起點，讓不同家人用自己的方式參與。有時只是一起坐着看圖，有時是幫忙拿穩紙邊，也可以甚麼都不問，等她自己說。請先按這些已經發生的事情整理，不要替我們安排新的課程，也不需要把每一個片段都變成待辦。';

},
108:function(module,exports,__require){
"use strict";
Object.defineProperty(exports, "__esModule", { value: true });
exports.media = void 0;
exports.media = { "text": { "base64": "6Zax6K6A6KeS5pW055CG5YKZ5b+YCuWclueVq+abuOaUvuWcqOefruaetu+8jOeVmeS4gOWAi+WPr+S7peWdkOS4i+aFouaFoue/u+abuOeahOS9jee9ruOAggo=", "bytes": 92, "sha256": "059e43356b601900d86535a039445555bc8868cd89f6718891ee7ca963307849", "mimeType": "text/plain" }, "voice": { "base64": "", "bytes": 3244, "sha256": "863a632ab2dd20cba721fab2d7811b1aa15f9b4878d44d3c775b0960324eb1fe", "mimeType": "audio/wav" }, "video": { "base64": "", "bytes": 1700, "sha256": "38008cae4b746b6186b8326a1991ee124cf9ed97f54035be632ef05233e5d668", "mimeType": "video/mp4" },
    "bridgeNote": { "mimeType": "text/plain", "bytes": 231, "sha256": "17162d408187057ff7aadff8b1102ed459ee20398785c370791134e48c8de0f2", "base64": "" }, "leafNote": { "mimeType": "text/plain", "bytes": 252, "sha256": "600381ba35fd54ffb7a4a9025c29c05350cbe9fc5ccf1d23c9a73f5aa3db5476", "base64": "" }, "backpackTone": { "mimeType": "audio/wav", "bytes": 4844, "sha256": "2b2801d389552746013b9ff3bafec8e924aa3cbaefa46961e1019c6193737f3a", "base64": "