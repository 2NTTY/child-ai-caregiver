{
  "expo": {
    "name": "育有方",
    "slug": "yuyoufang",
    "version": "0.1.0",
    "platforms": [
      "web",
      "android"
    ],
    "android": {
      "package": "org.yuyoufang.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "拍攝你選擇交給育有方整理的照片。",
          "photosPermission": "選擇你希望交給育有方整理的照片。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "錄製你選擇交給育有方的語音。",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png",
      "output": "static"
    },
    "scheme": "yuyoufang",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "8c63b9fc-b823-4b40-ba36-375ce43fa578"
      }
    }
  }
}
