{
  "expo": {
    "name": "育有方",
    "slug": "yuyoufang",
    "version": "0.1.0",
    "platforms": [
      "web",
      "android"
    ],
    "android": {
      "package": "org.yuyoufang.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png",
      "output": "static"
    },
    "scheme": "yuyoufang",
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
