{
  "name": "yuban-hk-frontend-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web --localhost",
    "typecheck": "tsc --noEmit",
    "test:forms": "node --test scripts/date-time.test.mts scripts/profile-form.test.mts scripts/family-preview.test.mjs scripts/memory-preview.test.mjs scripts/task-forms.test.mjs",
    "verify:colors": "node scripts/verify-colors.mjs",
    "build:web": "expo export --platform web",
    "build:android-ui": "expo export --platform android --output-dir dist-android",
    "verify:web": "node scripts/verify-ui.mjs",
    "verify:motion": "node scripts/verify-motion-preview.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "5.9.1",
    "expo": "57.0.24",
    "expo-blur": "57.0.3",
    "expo-constants": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.22",
    "lucide-react-native": "1.49.0",
    "luxon": "3.7.2",
    "overlayscrollbars": "2.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-paper-dates": "0.24.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/react": "19.2.4",
    "culori": "4.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "6.0.3"
  }
}
