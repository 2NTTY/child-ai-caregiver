  "semantics": {
    "quotaAuthority": "The existing root is admitted first. Model daily counter and attempt receipt share one separate Firestore transaction. Failures never refund or re-key the root.",
    "replay": "Original root+attempt key is independent of day and billing source. Duplicates only return lookup, including lost acknowledgement and process re-creation.",
    "metadata": "Encrypted fixed binding, outgoing fingerprint and allowlisted token/outcome metadata; no request/response bodies, prompts, secrets or household content.",
    "lateResults": "Accounting may settle late against the reservation day; does not change root/run state or grant execution. Same settlement is idempotent; conflicting outcomes rejected.",
    "externalCalls": "No provider, tool, SQL or notification inside transaction callbacks. No exactly-once guarantee for external provider execution."
  },
