+import { useLayoutEffect, useRef } from 'react';
+import { Platform, type View } from 'react-native';
+import type { PhotoOriginal } from '../../photo-view-model';
+
+type Intent = { scopeKey: string; selectedId: string | null; original: PhotoOriginal | null; origin: Element | null };
+
+/** Only an explicit local return may restore focus; ordinary owner publications cannot. */
+export function usePhotoListReturnFocus({ scopeKey, selectedId, original, enabled, ready, listVisible }: {
+  scopeKey: string; selectedId: string | null; original: PhotoOriginal | null; enabled: boolean; ready: boolean; listVisible: boolean;
+}) {
+  const listRef = useRef<View | null>(null), rows = useRef(new Map<string, View>());
+  const intent = useRef<Intent | null>(null);
+  const latest = useRef({ scopeKey, selectedId, original, enabled });
+  latest.current = { scopeKey, selectedId, original, enabled };
+  useLayoutEffect(() => {
+    if (Platform.OS !== 'web') return;
+    const cancel = () => { intent.current = null; };
+    const focus = (event: FocusEvent) => { if (intent.current && event.target !== intent.current.origin) cancel(); };
+    document.addEventListener('pointerdown', cancel, true);
+    document.addEventListener('keydown', cancel, true);
+    document.addEventListener('focusin', focus, true);
+    return () => {
+      cancel();
+      document.removeEventListener('pointerdown', cancel, true);
+      document.removeEventListener('keydown', cancel, true);
+      document.removeEventListener('focusin', focus, true);
+    };
+  }, []);
+  // Run after refs/visibility commit, including a later ready publication of the local index.
+  useLayoutEffect(() => {
+    const pending = intent.current;
+    if (!pending) return;
+    if (!enabled || pending.scopeKey !== scopeKey || pending.selectedId !== selectedId || pending.original !== original) {
+      intent.current = null; return;
+    }
+    if (!ready || !listVisible) return;
+    const active = Platform.OS === 'web' ? document.activeElement : null;
+    if (active && active !== document.body && active !== pending.origin) { intent.current = null; return; }
+    intent.current = null;
+    for (const node of [pending.selectedId ? rows.current.get(pending.selectedId) : null, listRef.current]) {
+      if (!node) continue;
+      if (Platform.OS === 'web') {
+        const target = node as unknown as HTMLElement;
+        if (!target.isConnected || target.hasAttribute('disabled') || target.getAttribute('aria-disabled') === 'true'
+          || target.closest('[inert], [aria-hidden="true"]') || !target.getClientRects().length) continue;
+        target.focus({ preventScroll: true });
+        if (!target.contains(document.activeElement)) continue;
+      } else node.focus();
+      return;
+    }
+  });
+  return { listRef,
+    rowRef: (id: string, node: View | null) => { if (node) rows.current.set(id, node); else rows.current.delete(id); },
+    cancel: () => { intent.current = null; },
+    request: () => {
+      const current = latest.current;
+      if (current.enabled) intent.current = { ...current, origin: Platform.OS === 'web' ? document.activeElement : null };
+    },
+  };
+}
